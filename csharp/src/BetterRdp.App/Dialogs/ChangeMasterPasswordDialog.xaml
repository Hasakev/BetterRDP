<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="BetterRdp_App.Dialogs.ChangeMasterPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change Master Password"
    PrimaryButtonText="Change password"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="12" Width="320">
        <TextBlock Text="Changing this password re-encrypts your saved credentials." TextWrapping="Wrap" />
        <PasswordBox x:Name="CurrentPasswordInput" Header="Current Master Password" />
        <PasswordBox x:Name="NewPasswordInput" Header="New Master Password" />
        <PasswordBox x:Name="ConfirmPasswordInput" Header="Confirm new Master Password" />
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
